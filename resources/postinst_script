#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    update-alternatives --install /usr/bin/x-www-browser \
        x-www-browser /opt/Zroot/zroot 80
    chown root /opt/Zroot/chrome-sandbox
    chmod 4755 /opt/Zroot/chrome-sandbox
    echo "Run sudo xdg-settings set default-web-browser zroot.desktop && sudo update-alternatives --config x-www-browser to set Zroot as your default browser."
    ln -sf /opt/Zroot/zroot /usr/bin/zroot
fi
