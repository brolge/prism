#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    update-alternatives --remove x-www-browser /opt/Zroot/zroot
    echo "Zroot has been removed from update-alternatives list."
    echo "If you set Zroot as your default in install steps or xdg-settings manually, please set another web browser yourself."
    echo "The following command is:"
    echo "xdg-settings set default-web-browser browser-name.desktop"
fi
